# Server-Only Environment Configuration (Never prefix secrets with VITE_)
# Copy to .env in local development. Never commit real secrets to version control.

NODE_ENV="production"
DEBUG="false"
PORT="3000"

# Application URL & Strict CORS Origin Allowlist (comma-separated)
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://ais-dev-x75dqq3r4k2j6ipvhy5li5-895889429216.asia-southeast1.run.app,https://ais-pre-x75dqq3r4k2j6ipvhy5li5-895889429216.asia-southeast1.run.app"

# Server-Side Session HMAC Secret (Minimum 32 bytes in production; Ephemeral CSPRNG fallback if unset)
SESSION_HMAC_SECRET=""
SESSION_TTL_MS="43200000"

# Role-Based Access Control (Bootstrapped Primary Admin Email)
ADMIN_EMAIL="mahitsaxena44@gmail.com"

# Sliding-Window Rate Limiting Thresholds
RATE_LIMIT_AUTH_MAX_PER_MIN="25"
RATE_LIMIT_API_MAX_PER_MIN="120"
RATE_LIMIT_ADMIN_MAX_PER_MIN="10"
RATE_LIMIT_WS_MAX_PER_10S="45"
